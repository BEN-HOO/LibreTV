{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "DEFAULT_SOURCES": "[{\"url\":\"http://caiji.dyttzyapi.com/api.php/provide/vod\",\"name\":\"电影天堂资源\"},{\"url\":\"https://cj.rycjapi.com/api.php/provide/vod\",\"name\":\"如意资源\"},{\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"name\":\"暴风资源\"},{\"url\":\"https://tyyszy.com/api.php/provide/vod\",\"name\":\"天涯资源\"},{\"url\":\"https://zy.xmm.hk/api.php/provide/vod\",\"name\":\"小猫咪资源\"},{\"url\":\"http://ffzy5.tv/api.php/provide/vod\",\"name\":\"非凡影视\"},{\"url\":\"https://json.heimuer.xyz/api.php/provide/vod\",\"name\":\"黑木耳\"},{\"url\":\"https://360zy.com/api.php/provide/vod\",\"name\":\"360资源\"},{\"url\":\"https://www.iqiyizyapi.com/api.php/provide/vod\",\"name\":\"iqiyi资源\"},{\"url\":\"https://wolongzyw.com/api.php/provide/vod\",\"name\":\"卧龙资源\"},{\"url\":\"https://cjhwba.com/api.php/provide/vod\",\"name\":\"华为吧资源\"},{\"url\":\"https://jszyapi.com/api.php/provide/vod\",\"name\":\"极速资源\"},{\"url\":\"https://dbzy.tv/api.php/provide/vod\",\"name\":\"豆瓣资源\"},{\"url\":\"https://mozhuazy.com/api.php/provide/vod\",\"name\":\"魔爪资源\"},{\"url\":\"https://www.mdzyapi.com/api.php/provide/vod\",\"name\":\"魔都资源\"},{\"url\":\"https://api.zuidapi.com/api.php/provide/vod\",\"name\":\"最大资源\"},{\"url\":\"https://m3u8.apiyhzy.com/api.php/provide/vod\",\"name\":\"樱花资源\"},{\"url\":\"https://api.apibdzy.com/api.php/provide/vod\",\"name\":\"百度云资源\"},{\"url\":\"https://api.wujinapi.me/api.php/provide/vod\",\"name\":\"无尽资源\"},{\"url\":\"https://wwzy.tv/api.php/provide/vod\",\"name\":\"旺旺短剧\"},{\"url\":\"https://ikunzyapi.com/api.php/provide/vod\",\"name\":\"iKun资源\"},{\"url\":\"https://cj.lziapi.com/api.php/provide/vod/\",\"name\":\"量子资源站\"}]"
