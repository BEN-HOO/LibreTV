{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "DEFAULT_SOURCES": "[{\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"name\":\"暴风资源\"},{\"url\":\"http://ffzy5.tv/api.php/provide/vod\",\"name\":\"非凡影视\"},{\"url\":\"https://api.wujinapi.me/api.php/provide/vod\",\"name\":\"无尽资源\"},{\"url\":\"https://cj.lziapi.com/api.php/provide/vod/\",\"name\":\"量子资源站\"}]",
    "SEARCH_MAX_PAGES": "2"
  },
  "minify": true,
  "workers_dev": true,
  "preview_urls": false
}
